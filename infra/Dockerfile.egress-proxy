# Egress proxy for the fetcher (build context: repo root).
# Build stage bundles proxy.ts + src/server/core/net-policy.ts (+ ipaddr.js) into one file;
# the final stage is node:22-alpine with only that file, no npm, no python, non-root.
FROM node:22-alpine AS build
WORKDIR /build
COPY package-lock.json ./
# Exact versions from the lockfile, without installing the whole app's dependency tree.
RUN node -e 'const p=require("./package-lock.json").packages; for (const n of ["esbuild","ipaddr.js"]) console.log(n+"@"+p["node_modules/"+n].version)' > deps.txt \
 && npm init -y >/dev/null \
 && npm install --no-save --no-audit --no-fund $(cat deps.txt)
COPY src/server/core/net-policy.ts src/server/core/net-policy.ts
COPY infra/egress-proxy/*.ts infra/egress-proxy/
RUN npx esbuild infra/egress-proxy/proxy.ts --bundle --platform=node --target=node22 --format=cjs --outfile=out/proxy.js

FROM node:22-alpine
# Package managers are not needed at runtime (and npm ships node-gyp's .py files).
RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-*
COPY --from=build /build/out/proxy.js /app/proxy.js
ENV NODE_ENV=production
USER 10001:10001
EXPOSE 3128
ENTRYPOINT ["node", "/app/proxy.js"]
