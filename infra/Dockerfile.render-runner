# The render service (build context: repo root). The only component with the Docker socket in compose; it holds no secret.
# Build stage bundles infra/render-runner + the pure render-job code (+ zod) into one file with the repo's own pinned esbuild/zod;
# the final stage is node:22-alpine with that file and the static Docker CLI: no npm, no python, non-root.
FROM node:22-alpine AS build
WORKDIR /build
COPY package-lock.json tsconfig.json ./
RUN node -e 'const p=require("./package-lock.json").packages; for (const n of ["esbuild","zod"]) console.log(n+"@"+p["node_modules/"+n].version)' > deps.txt \
 && npm init -y >/dev/null \
 && npm install --no-save --no-audit --no-fund $(cat deps.txt)
COPY infra/render-runner/*.ts infra/render-runner/
COPY src/server/render src/server/render
COPY src/server/core/paid-call.ts src/server/core/spend.ts src/server/core/
RUN npx esbuild infra/render-runner/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=out/runner.js

FROM node:22-alpine
# Package managers are not needed at runtime (and npm ships node-gyp's .py files).
RUN rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
           /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-*
# The static client only; the daemon is the host's (reached through the mounted socket).
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=build /build/out/runner.js /app/runner.js
ENV NODE_ENV=production
USER 10003:10003
EXPOSE 4100
ENTRYPOINT ["node", "/app/runner.js"]
