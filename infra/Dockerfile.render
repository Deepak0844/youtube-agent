# Render sandbox image: everything a Remotion render needs is baked in at build
# time (Chrome Headless Shell, Node packages, fonts). Nothing is downloaded at
# runtime, so it can run with --network none, a read-only root and a non-root user.
FROM node:22-bookworm-slim

# Remotion's Linux shared libraries (https://www.remotion.dev/docs/miscellaneous/linux-dependencies,
# Debian list, runtime packages) plus fontconfig. No font tooling that pulls in python.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libnss3 libdbus-1-3 libatk1.0-0 libasound2 libxrandr2 libxkbcommon0 \
      libxfixes3 libxcomposite1 libxdamage1 libgbm1 libcups2 libcairo2 \
      libpango-1.0-0 libatk-bridge2.0-0 fontconfig \
 && rm -rf /var/lib/apt/lists/*

COPY infra/render/fonts/*.ttf /usr/share/fonts/truetype/vendored/
# Licence notices travel with the redistributed fonts (OFL requires it).
COPY infra/render/fonts/OFL-*.txt infra/render/fonts/README.md /usr/share/doc/vendored-fonts/
RUN fc-cache -f

# Remotion + browser live inside the image, not in a per-user cache. The second package line is what the
# old shorts kit imports beyond Remotion core (lib/collage, lib/chatui, lib/browser, lib/kit). @remotion/*
# follow the image Remotion version (the old lockfile pins 4.0.486, whose @remotion/shapes would nest a
# second remotion copy); chroma-js and lucide-react are pinned to the old lockfile.
WORKDIR /opt/render
RUN npm init -y >/dev/null \
 && npm i --omit=dev --no-audit --no-fund --save-exact \
      remotion@4.0.538 @remotion/cli@4.0.538 @remotion/bundler@4.0.538 @remotion/renderer@4.0.538 \
      react@19.3.0 react-dom@19.3.0 \
      @remotion/shapes@4.0.538 @remotion/paths@4.0.538 chroma-js@3.2.0 lucide-react@1.23.0 \
 && npx remotion browser ensure \
 && shell="$(find /opt/render/node_modules/.remotion -type f -perm -u+x \( -name headless_shell -o -name chrome-headless-shell \) | head -n1)" \
 && if [ -z "$shell" ]; then echo "ERROR: no headless shell binary (headless_shell or chrome-headless-shell) found under /opt/render/node_modules/.remotion" >&2; exit 1; fi \
 && ln -s "$shell" /opt/render/chrome-headless-shell \
 && /opt/render/chrome-headless-shell --version \
 && npm cache clean --force \
 && chmod -R a+rX /opt/render \
 && rm -rf /root/.npm /tmp/*

ENV NODE_PATH=/opt/render/node_modules \
    REMOTION_BROWSER_EXECUTABLE=/opt/render/chrome-headless-shell \
    NODE_ENV=production

RUN useradd --uid 10001 --user-group --no-create-home --shell /usr/sbin/nologin render \
 && mkdir /job && chown render:render /job
ENV HOME=/tmp TMPDIR=/tmp
USER render
WORKDIR /job
