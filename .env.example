# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Provider API keys do not go here: save them in the app under Settings, Keys.

# --- Database setup: used only by `npm run db:bootstrap` (once per database) ---
BOOTSTRAP_DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:55432/ytstudio
YTSTUDIO_OWNER_PASSWORD=CHANGE_ME
YTSTUDIO_APP_PASSWORD=CHANGE_ME

# --- Database access ---
# Owner role: only for db:migrate, owner:create, owner:reset, auth:purge. Never give it to the web app or worker.
MIGRATE_DATABASE_URL=postgres://ytstudio_owner:CHANGE_ME@127.0.0.1:55432/ytstudio
# App role (least privilege): used by the web app and worker.
DATABASE_URL=postgres://ytstudio_app:CHANGE_ME@127.0.0.1:55432/ytstudio

# --- App ---
APP_URL=http://localhost:3000
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# TRUST_PROXY=1
# AUTH_MAX_IN_FLIGHT=3
# AUTH_MAX_PER_IP=1

# --- Vault master key ---
# Do not fill this in by hand: run `npm run vault:init`, which generates it and appends it to .env.local (and refuses
# to overwrite). Back it up in a password manager; losing it makes stored provider keys unrecoverable.
# VAULT_MASTER_KEY=
# Rotation only: the old key, decrypt-only, while VAULT_MASTER_KEY holds the new one. Then run `npm run vault:rotate`.
# VAULT_MASTER_KEY_PREVIOUS=

# --- Runtime services ---
REDIS_URL=redis://127.0.0.1:6379
SEARXNG_URL=http://127.0.0.1:8080
STORAGE_ROOT=.data
# BACKUP_DB_CONTAINER=ytstudio-dev-pg
