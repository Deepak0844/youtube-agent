# Copy values into .env.local (gitignored). Never commit real values.

# Vault master key: base64 of 32 random bytes. Do not fill this in by hand: run `npm run vault:init`, which generates
# it and appends it to .env.local (and refuses to overwrite). Left commented here so `cp .env.example .env.local` still works.
# Back it up in a password manager; losing it makes stored provider keys unrecoverable.
# VAULT_MASTER_KEY=
# Rotation only: the old key, decrypt-only, while VAULT_MASTER_KEY holds the new one. Then run `npm run vault:rotate`.
# VAULT_MASTER_KEY_PREVIOUS=

# Runtime services (DATABASE_URL must use the application role).
REDIS_URL=redis://127.0.0.1:6379
SEARXNG_URL=http://127.0.0.1:8080
STORAGE_ROOT=./storage
