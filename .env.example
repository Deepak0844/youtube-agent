# Copy values into .env.local (gitignored). Never commit real values.

# Vault master key: base64 of 32 random bytes. Generate with `npm run vault:init` (it appends to .env.local, never overwrites).
# Back it up in a password manager; losing it makes stored provider keys unrecoverable.
VAULT_MASTER_KEY=
# Rotation only: the old key, decrypt-only, while `VAULT_MASTER_KEY` holds the new one.
# VAULT_MASTER_KEY_PREVIOUS=
