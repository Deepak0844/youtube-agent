{
  "name": "youtube-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "totp:backfill": "tsx --env-file-if-exists=.env.local scripts/totp-backfill.ts",
    "vault:init": "tsx scripts/vault-init.ts",
    "vault:check": "tsx --env-file-if-exists=.env.local scripts/vault-check.ts",
    "vault:rotate": "tsx --env-file-if-exists=.env.local scripts/vault-rotate.ts",
    "owner:create": "tsx scripts/owner-create.ts",
    "owner:reset": "tsx scripts/owner-reset.ts",
    "auth:purge": "tsx scripts/auth-purge.ts",
    "worker": "tsx src/worker/index.ts",
    "dev:all": "concurrently -k -n web,worker \"next dev -H 127.0.0.1\" \"tsx watch src/worker/index.ts\"",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p infra/egress-proxy",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:api": "playwright test --project=api",
    "image:render": "docker build -f infra/Dockerfile.render -t ytstudio-render:dev .",
    "test:ui": "playwright test --project=ui-desktop --project=ui-phone",
    "image:egress-proxy": "docker build -f infra/Dockerfile.egress-proxy -t ytstudio-egress-proxy:dev ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/openai-compatible": "^3.0.78",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "ai": "^7.0.153",
    "bullmq": "^6.4.2",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "get-port": "^7.2.0",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
