{
  "title": "மூன்று இதயங்கள்",
  "beats": [
    { "id": "b1", "text": "ஆக்டோபஸுக்கு மூன்று இதயங்கள் உள்ளன." },
    { "id": "b2", "text": "இரண்டு இதயங்கள் இரத்தத்தை செவுள்களுக்கு அனுப்புகின்றன." },
    { "id": "b3", "text": "மூன்றாவது இதயம் உடல் முழுவதும் இரத்தத்தை அனுப்புகிறது." },
    { "id": "b4", "text": "ஆக்டோபஸ் நீந்தும்போது மூன்றாவது இதயம் நின்றுவிடுகிறது." }
  ]
}
